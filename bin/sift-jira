#!/usr/bin/env python3
"""Sift's ONLY Jira path — reads free, writes from an approved plan.

Reads (`search`, `issue`) run freely. Writes happen ONLY via `apply`, which executes a
change plan a human already approved in the turn (skills/turn Step 2). The deny rails in
config/gating.json block every other Jira write path — Atlassian MCP write tools, raw
curl/HTTP writes to *.atlassian.net, `acli jira` / `jira` CLI writes — so Jira changes leave
Sift only through here, each one logged with who approved it.

Usage:
  bin/sift-jira search --jql "project = CCCT AND statusCategory != Done" [--max 200]
      -> JSON array of {id, ts, key, summary, status, ...}; pipe into `canopy cursor since`.
  bin/sift-jira issue CCCT-412            -> one issue, full fields + links + comments + changelog
  bin/sift-jira transitions CCCT-412      -> statuses this issue can move to right now
  bin/sift-jira sprints [--state closed] [--since 2026-10-01]   -> sprints on the Blue/Green/Mobile boards
  bin/sift-jira sprint-data 6527          -> one sprint: completed vs not, type mix, epics (skills/sprint-report)
  bin/sift-jira apply plan.json --approved-by "<name>" [--dry-run]

Plan file (written by skills/clean-the-backlog, roadmap-intake and the other sweep skills):
  {"title": "...", "changes": [
     {"key": "CCCT-412", "op": "comment",    "body": "plain text", "why": "..."},
     {"key": "CCCT-412", "op": "transition", "to": "Won't Do",     "why": "..."},
     {"key": "CCCT-412", "op": "update",     "fields": {"priority": {"name": "Low"}}, "why": "..."},
     {"key": "CCCT-412", "op": "link", "type": "Duplicate", "outward": "CCCT-388", "why": "..."},
     {"op": "create", "ref": "tech-debt", "project": "CCC", "type": "Idea",
      "fields": {"summary": "...", "description": "plain text", "customfield_14111": [...]}, "why": "..."},
     {"key": "CCCT-2067", "op": "link", "type": "Polaris work item link", "outward": "$tech-debt", "why": "..."}]}
  `create` makes a new issue; `description` is plain text (converted to ADF). Its `ref` names the
  new key for later rows: write "$<ref>" as any later row's `key` or `outward`. A row whose ref
  failed to create errors instead of running. In a dry run the ref stays a placeholder.

Config (from ~/.sift/.env via bin/_env.py): sift_JIRA_SITE, sift_JIRA_EMAIL,
sift_JIRA_API_TOKEN, sift_JIRA_PROJECTS.
"""
import argparse
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _env import get  # noqa: E402

FIELDS = ("summary,status,priority,assignee,reporter,issuetype,parent,labels,created,updated,description,"
          "components,issuelinks,customfield_10001,customfield_10448,customfield_10434,customfield_14111,customfield_12800,customfield_11029")
# customfield_10001 = Team; CCC only: 10448 = Product Area, 10434 = Platform, 14111 = Goal (2027 themes), 12800 = Prioritization, 11029 = Product Pod


def _client():
    site = get("sift_JIRA_SITE", "dimagi.atlassian.net")
    email, token = get("sift_JIRA_EMAIL", ""), get("sift_JIRA_API_TOKEN", "")
    if not (email and token):
        sys.exit("sift_JIRA_EMAIL / sift_JIRA_API_TOKEN not set — run /sift:setup.")
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    return f"https://{site}/rest/api/3", {
        "Authorization": f"Basic {auth}",
        "Accept": "application/json",
        "Content-Type": "application/json",
    }


def _call(method, path, body=None, query=None):
    base, headers = _client()
    url = base + path + ("?" + urllib.parse.urlencode(query) if query else "")
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            raw = r.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        sys.exit(f"Jira {method} {path} -> {e.code}: {e.read().decode(errors='replace')[:500]}")


def _adf(text):
    """Plain text -> Atlassian Document Format (one paragraph per blank-line block)."""
    paras = [p for p in text.split("\n\n") if p.strip()]
    return {"type": "doc", "version": 1, "content": [
        {"type": "paragraph", "content": [{"type": "text", "text": p.strip()}]} for p in paras]}


def _summarize(issue):
    f = issue["fields"]
    name = lambda v: (v or {}).get("displayName") or (v or {}).get("name")  # noqa: E731
    return {
        "id": issue["key"], "ts": f.get("updated"), "key": issue["key"],
        "summary": f.get("summary"), "status": name(f.get("status")),
        "priority": name(f.get("priority")), "type": name(f.get("issuetype")),
        "assignee": name(f.get("assignee")), "reporter": name(f.get("reporter")),
        "parent": (f.get("parent") or {}).get("key"), "labels": f.get("labels") or [],
        "created": f.get("created"), "has_description": bool(f.get("description")),
        "parent_type": name(((f.get("parent") or {}).get("fields") or {}).get("issuetype")),
        "components": [c["name"] for c in f.get("components") or []],
        "team": name(f.get("customfield_10001")),
        "product_area": [o["value"] for o in f.get("customfield_10448") or []],
        "platform": [o["value"] for o in f.get("customfield_10434") or []],
        "goal": [o["value"] for o in f.get("customfield_14111") or []],
        "prioritization": (f.get("customfield_12800") or {}).get("value"),
        "product_pod": (f.get("customfield_11029") or {}).get("value"),
        "links": [{"type": lk["type"]["name"], "key": (lk.get("outwardIssue") or lk.get("inwardIssue"))["key"]}
                  for lk in f.get("issuelinks") or []],
    }


def cmd_search(a):
    out, token = [], None
    while len(out) < a.max:
        q = {"jql": a.jql, "fields": FIELDS, "maxResults": min(100, a.max - len(out))}
        if token:
            q["nextPageToken"] = token
        page = _call("GET", "/search/jql", query=q)
        out += [_summarize(i) for i in page.get("issues", [])]
        token = page.get("nextPageToken")
        if not token:
            break
    json.dump(out, sys.stdout, indent=1)
    print()


def cmd_issue(a):
    json.dump(_call("GET", f"/issue/{a.key}", query={"fields": "*all", "expand": "renderedFields,changelog"}),
              sys.stdout, indent=1)
    print()


def cmd_transitions(a):
    ts = _call("GET", f"/issue/{a.key}/transitions")["transitions"]
    json.dump([{"id": t["id"], "name": t["name"], "to": t["to"]["name"],
                "category": t["to"]["statusCategory"]["name"]} for t in ts], sys.stdout, indent=1)
    print()


TEAM_BOARDS = {2830: "Blue", 2829: "Green", 2831: "Mobile"}  # CCCT scrum boards (342 "All Connect Tech" duplicates them)
SPRINT_FIELDS = "summary,status,issuetype,parent,resolutiondate,assignee,components,customfield_10010,customfield_10017,customfield_10001"


def _agile(path, query=None):
    base, headers = _client()
    url = base.replace("/rest/api/3", "/rest/agile/1.0") + path + ("?" + urllib.parse.urlencode(query) if query else "")
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        sys.exit(f"Jira GET {path} -> {e.code}: {e.read().decode(errors='replace')[:500]}")


def _jql_all(jql, fields):
    out, token = [], None
    while True:
        q = {"jql": jql, "fields": fields, "maxResults": 100}
        if token:
            q["nextPageToken"] = token
        page = _call("GET", "/search/jql", query=q)
        out += page.get("issues", [])
        token = page.get("nextPageToken")
        if not token:
            return out


def cmd_sprints(a):
    """Closed (or any-state) sprints on the three team boards, newest first."""
    out = []
    for board, team in TEAM_BOARDS.items():
        start = 0
        while True:
            page = _agile(f"/board/{board}/sprint", {"state": a.state, "startAt": start, "maxResults": 50})
            for s in page.get("values", []):
                day = (s.get("completeDate") or s.get("endDate") or "")[:10]
                if day >= a.since:
                    if any(o["id"] == s["id"] for o in out):  # sprint shared by Blue + Green boards
                        next(o for o in out if o["id"] == s["id"])["team"] += f"+{team}"
                        continue
                    out.append({"id": s["id"], "team": team, "name": s["name"], "state": s["state"],
                                "start": s.get("startDate"), "end": s.get("endDate"), "completed": s.get("completeDate")})
            if page.get("isLast", True):
                break
            start += 50
    out.sort(key=lambda s: s["completed"] or s["end"] or "", reverse=True)
    json.dump(out, sys.stdout, indent=1)
    print()


def _kind(t):
    return t if t in ("Story", "Task", "Bug", "Design", "Test") else "Other"


def cmd_sprint_data(a):
    """Everything skills/sprint-report needs about one closed sprint, computed read-only."""
    sp = _agile(f"/sprint/{a.sprint_id}")
    closed_at = sp.get("completeDate") or sp.get("endDate")
    pod = a.team or TEAM_BOARDS.get(sp.get("originBoardId"))
    if pod not in TEAM_BOARDS.values():
        sys.exit(f"--team Blue|Green|Mobile is required for sprint {a.sprint_id} (couldn't infer it from its board).")
    # A report covers ONE pod. Blue and Green sometimes share a Jira sprint, so membership comes from the Team field.
    all_issues = _jql_all(f"sprint = {a.sprint_id}", SPRINT_FIELDS)
    team_of = lambda i: ((i["fields"].get("customfield_10001") or {}).get("name") or "")  # noqa: E731
    issues = [i for i in all_issues if f"Connect: {pod} " in team_of(i) + " "]
    excluded = [{"key": i["key"], "team": team_of(i) or None} for i in all_issues if i not in issues]
    name = lambda v: (v or {}).get("displayName") or (v or {}).get("name")  # noqa: E731
    rows, epics = [], {}
    for i in issues:
        f = i["fields"]
        resolved = f.get("resolutiondate")
        is_done = f["status"]["statusCategory"]["key"] == "done"
        dropped = is_done and f["status"]["name"].lower() in ("won't do", "wont do", "duplicate", "cancelled", "rejected")
        # Done only counts if it was resolved by the time the sprint closed; later = carried over, finished afterwards.
        done_in_sprint = is_done and not dropped and bool(resolved) and _utc(resolved) <= closed_at
        later = [s["name"] for s in f.get("customfield_10010") or [] if s["id"] != sp["id"] and s["state"] != "closed"]
        later += [s["name"] for s in f.get("customfield_10010") or [] if s["id"] != sp["id"] and s["state"] == "closed"
                  and (s.get("completeDate") or "") > closed_at]
        par = f.get("parent") or {}
        epic = par["key"] if (par.get("fields") or {}).get("issuetype", {}).get("name") == "Epic" else None
        if epic:
            epics.setdefault(epic, par["fields"]["summary"])
        rows.append({"key": i["key"], "summary": f["summary"], "type": f["issuetype"]["name"], "kind": _kind(f["issuetype"]["name"]),
                     "status": f["status"]["name"], "points": f.get("customfield_10017"), "assignee": name(f.get("assignee")),
                     "components": [c["name"] for c in f.get("components") or []], "epic": epic,
                     "completed": done_in_sprint, "dropped": dropped, "resolved": resolved,
                     "finished_after_close": is_done and not dropped and not done_in_sprint,
                     "carried_to": later})
    epic_out = []
    for key, title in epics.items():
        kids = _jql_all(f"parent = {key}", "status,resolutiondate")
        done = sum(k["fields"]["status"]["statusCategory"]["key"] == "done" for k in kids)
        in_sprint = [r for r in rows if r["epic"] == key]
        epic_out.append({"key": key, "summary": title, "children": len(kids), "children_done": done,
                         "in_sprint": len(in_sprint), "completed_in_sprint": sum(r["completed"] for r in in_sprint),
                         "fully_finalized": bool(kids) and done == len(kids) and any(r["completed"] for r in in_sprint)})

    def mix(sel):
        res = {}
        for r in sel:
            b = res.setdefault(r["kind"], {"count": 0, "points": 0, "unpointed": 0})
            b["count"] += 1
            b["points"] += r["points"] or 0
            b["unpointed"] += r["points"] is None
        return res

    json.dump({"sprint": {"id": sp["id"], "name": sp["name"], "team": pod,
                          "start": sp.get("startDate"), "end": sp.get("endDate"), "completed": sp.get("completeDate"), "goal": sp.get("goal")},
               "totals": {"issues": len(rows), "completed": sum(r["completed"] for r in rows),
                          "dropped": sum(r["dropped"] for r in rows),
                          "points": sum(r["points"] or 0 for r in rows),
                          "points_completed": sum(r["points"] or 0 for r in rows if r["completed"])},
               "mix_all": mix(rows), "mix_completed": mix([r for r in rows if r["completed"]]),
               "excluded_other_or_no_team": excluded, "epics": epic_out, "issues": rows}, sys.stdout, indent=1)
    print()


def _utc(ts):
    """Jira '2026-11-03T10:16:35.584-0500' -> '2026-11-03T15:16:35.584Z' (sortable against agile API UTC stamps)."""
    from datetime import datetime, timezone
    return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S.%f%z").astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def _resolve(v, refs):
    if isinstance(v, str) and v.startswith("$"):
        if v[1:] not in refs:
            raise ValueError(f"unknown or failed ref {v!r}")
        return refs[v[1:]]
    return v


def _apply_one(c, refs):
    op = c["op"]
    if op == "create":
        fields = dict(c["fields"])
        if isinstance(fields.get("description"), str):
            fields["description"] = _adf(fields["description"])
        fields["project"] = {"key": c["project"]}
        fields["issuetype"] = {"name": c["type"]}
        made = _call("POST", "/issue", {"fields": fields})
        if c.get("ref"):
            refs[c["ref"]] = made["key"]
        return made["key"]
    key = _resolve(c["key"], refs)
    if op == "comment":
        _call("POST", f"/issue/{key}/comment", {"body": _adf(c["body"])})
    elif op == "update":
        _call("PUT", f"/issue/{key}", {"fields": c["fields"]})
    elif op == "transition":
        ts = _call("GET", f"/issue/{key}/transitions")["transitions"]
        want = c["to"].lower()
        hit = next((t for t in ts if t["to"]["name"].lower() == want or t["name"].lower() == want), None)
        if not hit:
            raise ValueError(f"no transition to {c['to']!r}; available: {[t['to']['name'] for t in ts]}")
        _call("POST", f"/issue/{key}/transitions", {"transition": {"id": hit["id"]}})
    elif op == "link":
        _call("POST", "/issueLink", {"type": {"name": c["type"]},
                                     "inwardIssue": {"key": key}, "outwardIssue": {"key": _resolve(c["outward"], refs)}})
    else:
        raise ValueError(f"unknown op {op!r}")


def cmd_apply(a):
    if not a.approved_by.strip():
        sys.exit("--approved-by is required: name the human who approved this plan.")
    plan = json.load(open(a.plan, encoding="utf-8"))
    changes = plan.get("changes") or []
    results, refs = [], {}
    for c in changes:
        line = {"key": c.get("key") or f"(new {c.get('project')} {c.get('type')} ${c.get('ref')})",
                "op": c.get("op"), "why": c.get("why")}
        if c.get("op") == "link":
            line["outward"] = c.get("outward")
        if a.dry_run:
            results.append({**line, "result": "dry-run"})
            continue
        try:
            made = _apply_one(c, refs)
            results.append({**line, "result": "ok", **({"created": made} if made else {})})
        except (ValueError, KeyError, SystemExit) as e:
            results.append({**line, "result": f"error: {e}"})
    json.dump({"plan": plan.get("title"), "approved_by": a.approved_by, "dry_run": a.dry_run,
               "applied": sum(r["result"] == "ok" for r in results), "results": results},
              sys.stdout, indent=1)
    print()
    sys.exit(1 if any(r["result"].startswith("error") for r in results) else 0)


def main():
    p = argparse.ArgumentParser(prog="sift-jira", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("search")
    s.add_argument("--jql", required=True)
    s.add_argument("--max", type=int, default=200)
    s.set_defaults(fn=cmd_search)
    i = sub.add_parser("issue")
    i.add_argument("key")
    i.set_defaults(fn=cmd_issue)
    t = sub.add_parser("transitions")
    t.add_argument("key")
    t.set_defaults(fn=cmd_transitions)
    sp = sub.add_parser("sprints")
    sp.add_argument("--state", default="closed", help="closed | active | future (default closed)")
    sp.add_argument("--since", default="2000-01-01", help="only sprints closed/ending on or after YYYY-MM-DD")
    sp.set_defaults(fn=cmd_sprints)
    sd = sub.add_parser("sprint-data")
    sd.add_argument("sprint_id", type=int)
    sd.add_argument("--team", choices=sorted(TEAM_BOARDS.values()), help="pod whose tickets to report (Jira Team field)")
    sd.set_defaults(fn=cmd_sprint_data)
    ap = sub.add_parser("apply")
    ap.add_argument("plan")
    ap.add_argument("--approved-by", required=True)
    ap.add_argument("--dry-run", action="store_true")
    ap.set_defaults(fn=cmd_apply)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
